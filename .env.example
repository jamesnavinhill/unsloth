# LFM2.5 humanizer — project environment template
# Copy to .env and fill in. .env is gitignored; NEVER commit real values.
# On Google Colab, use Colab Secrets (Runtime > Secrets) with matching keys.
# All connections documented in CONNECTIONS.md.

# --- Credentials -------------------------------------------------------

# GitHub PAT — https://github.com/settings/tokens (repo, workflow scope)
GITHUB_PAT_TOKEN=

# Hugging Face — https://huggingface.co/settings/tokens
# Fine-grained token with Write role for pushing datasets, adapters, and model repos.
HF_TOKEN=

# Weights & Biases — https://wandb.ai/authorize
# Primary API key and optional service-account key
WANDB_API_KEY=
WANDB_SA_API_KEY=
WANDB_PROJECT=copyright
WANDB_ENTITY=navin_hill

# Agency gateway (LiteLLM proxy) — for synthetic traces, rewriters, and LLM-as-judge evals
GATEWAY_BASE_URL=https://gateway.yrka.io/v1
GATEWAY_FALLBACK_URL=
GATEWAY_API_KEY=

# Kaggle API — https://www.kaggle.com/settings/account (dataset provenance)
# Used via basic auth against api.kaggle.com/v1 (no ~/.kaggle/kaggle.json required)
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# --- Project constants -------------------------------------------------
HF_USERNAME=jamesnavinhill
HF_BUCKET_CC=jamesnavinhill/CommonCrawl-CreativeCommons-bucket
HF_BUCKET_CCCC=jamesnavinhill/cccc_all_domains-bucket
TARGET_MODEL=LiquidAI/LFM2.5-2.6B
